Options -Indexes
DirectoryIndex index.php
<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow"
  Header always set X-Content-Type-Options "nosniff"
</IfModule>
<FilesMatch "^(config|lib|lib3|api3|ingest|passwd|deploy_lib)\.php$">
  Require all denied
</FilesMatch>
<FilesMatch "\.(json|md|sh|log|tmp)$">
  Require all denied
</FilesMatch>
